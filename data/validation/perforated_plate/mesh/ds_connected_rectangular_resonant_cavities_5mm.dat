MP,SONC,1,343.395034,	! m s^-1
MP,VISC,1,1.8247e-05,	! Pa s
MP,KXX,1,0.025503,	! W m^-1 C^-1
MP,C,1,1006.400178,	! J kg^-1 C^-1
MP,UVID,1,1091f5ce-275e-4d3f-bf61-795d6d9529b0
MP,UMID,1,81fb0875-c913-49a8-be11-d038745c6f6e

MP,MURX,2,1,
MP,DENS,2,1.204263,	! kg m^-3
MP,SONC,2,343.395034,	! m s^-1
MP,VISC,2,1.8247e-05,	! Pa s
MP,KXX,2,0.025503,	! W m^-1 C^-1
MP,C,2,1006.400178,	! J kg^-1 C^-1
MP,UVID,2,1091f5ce-275e-4d3f-bf61-795d6d9529b0
MP,UMID,2,81fb0875-c913-49a8-be11-d038745c6f6e

