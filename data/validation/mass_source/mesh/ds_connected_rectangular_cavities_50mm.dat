*EXPORT,C_MatrixDense,CSV,Cdense.csv,24,
!*PRINT,M_MatrixDense,Mdense.matrix

! Mass global matrix
*DMAT,Q_Vector,Z,IMPORT,FULL,file.full,RHS
*EXPORT,Q_Vector,CSV,Qvector.csv,24,
!*PRINT,M_MatrixDense,Mdense.matrix


