N_MODES = 12

*DIM,nat_frequencies,ARRAY,N_MODES,2
*VFILL,nat_frequencies(1,1),ramp,1,1

!FINISH

*DO,i,1,N_MODES,1

!SET,1,i,,0
!*GET, nat_frequencies(i,2), ACTIVE, 0, SET, FREQ,

*GET,nat_frequencies(i,2),MODE,i,FREQ
*ENDDO

*MWRITE,nat_frequencies,natural_frequencies_Ansys,dat
(F10.0,TL1,10000E20.12)

! ****** End   Command Snippet ******
