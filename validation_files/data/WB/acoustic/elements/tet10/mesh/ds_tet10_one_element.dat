! ****** Begin Command Snippet ******
!   Commands inserted into this file will be executed just prior to the ANSYS SOLVE command.
!   These commands may supersede command settings set by Workbench.

!   Active UNIT system in Workbench when this object was created:  Metric (m, kg, N, s, V, A)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.


!   Commands inserted into this file will be executed immediately after the ANSYS /POST1 command.

!   Active UNIT system in Workbench when this object was created:  Metric (m, kg, N, s, V, A)
!   NOTE:  Any data that requires units (such as mass) is assumed to be in the consistent solver unit system.
!                See Solving Units in the help system for more information.


N_FREQ = 120
N_COLF = 1 + 2*N_FREQ
N_COLV = 1 + 6*N_FREQ

!
*dim,ratio,ARRAY,N_FREQ,1
*DIM,frequencies,ARRAY,N_FREQ,1
!
CMSEL,S,'input_face',NODE
CM,LIST_NODES,NODE
!
*GET,N_NODES_IF,NODE,,COUNT
*GET,N_MAX_IF,NODE,,num,max
!
*DIM,nodal_area_input,ARRAY,N_NODES_IF,2
*DIM,PRESSURE_IF,ARRAY,N_NODES_IF,N_COLF
*DIM,VELOCITY_IF,ARRAY,N_NODES_IF,N_COLV
*DIM,mask_IF,array,N_MAX_IF
*DIM,NODES_NS_IF,ARRAY,N_NODES_IF,1
*DIM,NODES_ID_FULL_IF,ARRAY,N_MAX_IF,1
*DIM,data_full_IF,array,N_MAX_IF,N_COLF
*DIM,data_full_VIF,array,N_MAX_IF,N_COLV
!
*VGET,NODES_NS_IF,NODE,,NLIST
*VGET,mask_IF(1),NODE,,NSEL
*VFILL,NODES_ID_FULL_IF,ramp,1,1

!Harmonic Analysis create a 2*Nf set of results (Real part + Imaginary part)

!PRAS, LWIN, 1, all, , , OB0, --, 51, , , 2.634167, 225.307464
!PRAS, LWOUT, 1, all, , , OB0, --, 51, 52, , 2.634167, 225.307464
!PRAS, PALL, 1, all, , , OB0, --, 51, 52, , 2.634167, 225.307464

*DO,I,1,N_FREQ,1

! STORE REAL PART OF DISPLACEMENT

SET,1,I,,0

!PRAS, LWIN, 1, I, , , OB0, --, 51, , , 2.634167, 225.307464

*GET, frequencies(I,1), ACTIVE, 0, SET, FREQ,

*VMASK,mask_IF(1)
*VGET,data_full_IF(1,2+(I-1)*2),NODE,all,PRESS,

*VMASK,mask_IF(1)
*VGET,data_full_VIF(1,2+(I-1)*6),NODE,all,PG,X

*VMASK,mask_IF(1)
*VGET,data_full_VIF(1,4+(I-1)*6),NODE,all,PG,Y

*VMASK,mask_IF(1)
*VGET,data_full_VIF(1,6+(I-1)*6),NODE,all,PG,Z

! STORE IMAGINARY PART OF DISPLACEMENT

SET,1,I,,1

*VMASK,mask_IF(1)
*VGET,data_full_IF(1,3+(I-1)*2),NODE,all,PRESS,

*VMASK,mask_IF(1)
*VGET,data_full_VIF(1,3+(I-1)*6),NODE,all,PG,X

*VMASK,mask_IF(1)
*VGET,data_full_VIF(1,5+(I-1)*6),NODE,all,PG,Y

*VMASK,mask_IF(1)
*VGET,data_full_VIF(1,7+(I-1)*6),NODE,all,PG,Z


*VMASK,mask_IF(1)
*VFUN,PRESSURE_IF(1,2+(I-1)*2),COMP,data_full_IF(1,2+(I-1)*2)

*VMASK,mask_IF(1)
*VFUN,VELOCITY_IF(1,2+(I-1)*6),COMP,data_full_VIF(1,2+(I-1)*6)

*VMASK,mask_IF(1)
*VFUN,VELOCITY_IF(1,4+(I-1)*6),COMP,data_full_VIF(1,4+(I-1)*6)

*VMASK,mask_IF(1)
*VFUN,VELOCITY_IF(1,6+(I-1)*6),COMP,data_full_VIF(1,6+(I-1)*6)


*VMASK,mask_IF(1)
*VFUN,PRESSURE_IF(1,3+(I-1)*2),COMP,data_full_IF(1,3+(I-1)*2)

*VMASK,mask_IF(1)
*VFUN,VELOCITY_IF(1,3+(I-1)*6),COMP,data_full_VIF(1,3+(I-1)*6)

*VMASK,mask_IF(1)
*VFUN,VELOCITY_IF(1,5+(I-1)*6),COMP,data_full_VIF(1,5+(I-1)*6)

*VMASK,mask_IF(1)
*VFUN,VELOCITY_IF(1,7+(I-1)*6),COMP,data_full_VIF(1,7+(I-1)*6)


*ENDDO

*VMASK,mask_IF(1)
*VFUN,PRESSURE_IF(1,1),COMP,NODES_ID_FULL_IF(1,1)

*VMASK,mask_IF(1)
*VFUN,VELOCITY_IF(1,1),COMP,NODES_ID_FULL_IF(1,1)

*VMASK,mask_IF(1)
*VFUN,nodal_area_input(1,1),COMP,NODES_ID_FULL_IF(1,1)

NSEL, ALL
*DO,k,1,N_NODES_IF,1

node_id = nodal_area_input(k,1)
nodal_area_input(k,2) = arnode(node_id)

*ENDDO

!!! Exporta os resultados nodais - pressões Re{P} e Im{P}

*MWRITE,PRESSURE_IF,nodal_pressure_input_face,dat
(F10.0,TL1,10000E20.12)

*MWRITE,VELOCITY_IF,particle_velocity_input_face,dat
(F10.0,TL1,10000E20.12)

*MWRITE,nodal_area_input,nodal_area_input_face,dat
(F10.4,TL1,10000E20.12)


!
CMSEL,S,'output_face',NODE
CM,LIST_NODES,NODE
!
*GET,N_NODES_OF,NODE,,COUNT
*GET,N_MAX_OF,NODE,,num,max
!
*DIM,nodal_area_output,ARRAY,N_NODES_OF,2
*DIM,PRESSURE_OF,ARRAY,N_NODES_OF,N_COLF
*DIM,VELOCITY_OF,ARRAY,N_NODES_OF,N_COLV
*DIM,mask_OF,array,N_MAX_OF
*DIM,NODES_NS_OF,ARRAY,N_NODES_OF,1
*DIM,NODES_ID_FULL_OF,ARRAY,N_MAX_OF,1
*DIM,data_full_OF,array,N_MAX_OF,N_COLF
*DIM,data_full_VOF,array,N_MAX_OF,N_COLV
!
*VGET,NODES_NS_OF,NODE,,NLIST
*VGET,mask_OF(1),NODE,,NSEL
*VFILL,NODES_ID_FULL_OF,ramp,1,1

!Harmonic Analysis create a 2*Nf set of results (Real part + Imaginary part)

*DO,I,1,N_FREQ,1

! STORE REAL PART OF DISPLACEMENT

SET,1,I,,0

*GET, frequencies(I,1), ACTIVE, 0, SET, FREQ,

*VMASK,mask_OF(1)
*VGET,data_full_OF(1,2+(I-1)*2),NODE,all,PRESS,

*VMASK,mask_OF(1)
*VGET,data_full_VOF(1,2+(I-1)*6),NODE,all,PG,X

*VMASK,mask_OF(1)
*VGET,data_full_VOF(1,4+(I-1)*6),NODE,all,PG,Y

*VMASK,mask_OF(1)
*VGET,data_full_VOF(1,6+(I-1)*6),NODE,all,PG,Z

! STORE IMAGINARY PART OF DISPLACEMENT

SET,1,I,,1

*VMASK,mask_OF(1)
*VGET,data_full_OF(1,3+(I-1)*2),NODE,all,PRESS,

*VMASK,mask_OF(1)
*VGET,data_full_VOF(1,3+(I-1)*6),NODE,all,PG,X

*VMASK,mask_OF(1)
*VGET,data_full_VOF(1,5+(I-1)*6),NODE,all,PG,Y

*VMASK,mask_OF(1)
*VGET,data_full_VOF(1,7+(I-1)*6),NODE,all,PG,Z


*VMASK,mask_OF(1)
*VFUN,PRESSURE_OF(1,2+(I-1)*2),COMP,data_full_OF(1,2+(I-1)*2)

*VMASK,mask_OF(1)
*VFUN,VELOCITY_OF(1,2+(I-1)*6),COMP,data_full_VOF(1,2+(I-1)*6)

*VMASK,mask_OF(1)
*VFUN,VELOCITY_OF(1,4+(I-1)*6),COMP,data_full_VOF(1,4+(I-1)*6)

*VMASK,mask_OF(1)
*VFUN,VELOCITY_OF(1,6+(I-1)*6),COMP,data_full_VOF(1,6+(I-1)*6)


*VMASK,mask_OF(1)
*VFUN,PRESSURE_OF(1,3+(I-1)*2),COMP,data_full_OF(1,3+(I-1)*2)

*VMASK,mask_OF(1)
*VFUN,VELOCITY_OF(1,3+(I-1)*6),COMP,data_full_VOF(1,3+(I-1)*6)

*VMASK,mask_OF(1)
*VFUN,VELOCITY_OF(1,5+(I-1)*6),COMP,data_full_VOF(1,5+(I-1)*6)

*VMASK,mask_OF(1)
*VFUN,VELOCITY_OF(1,7+(I-1)*6),COMP,data_full_VOF(1,7+(I-1)*6)


*ENDDO

*VMASK,mask_OF(1)
*VFUN,PRESSURE_OF(1,1),COMP,NODES_ID_FULL_OF(1,1)

*VMASK,mask_OF(1)
*VFUN,VELOCITY_OF(1,1),COMP,NODES_ID_FULL_OF(1,1)

*VMASK,mask_OF(1)
*VFUN,nodal_area_output(1,1),COMP,NODES_ID_FULL_OF(1,1)


NSEL, ALL
*DO,k,1,N_NODES_OF,1

node_id = nodal_area_output(k,1)
nodal_area_output(k,2) = arnode(node_id)

*ENDDO

!!! Exporta os resultados nodais - pressões Re{P} e Im{P}

*MWRITE,PRESSURE_OF,nodal_pressure_output_face,dat
(F10.0,TL1,10000E20.12)

*MWRITE,VELOCITY_OF,particle_velocity_output_face,dat
(F10.0,TL1,10000E20.12)

*MWRITE,nodal_area_output,nodal_area_output_face,dat
(F10.0,TL1,10000E20.12)


!!! Vetor frequencias da Analise Harmonica

*CFOPEN, analysis_frequencies, dat
*VWRITE,frequencies(1,1)
(F10.4)
*CFCLOS

! ****** End   Command Snippet ******
xmlo,ENCODING,ISO-8859-1
