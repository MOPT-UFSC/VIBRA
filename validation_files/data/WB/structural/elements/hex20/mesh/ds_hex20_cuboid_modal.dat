N_MODES = 40
*DIM, natural_frequencies, ARRAY, N_MODES, 2

*DO,j,1,N_MODES,1

*GET,natural_frequencies(j,2),MODE,j,FREQ

*ENDDO

*DIM,MODES_INDEXES,ARRAY,N_MODES,1
*VFILL, MODES_INDEXES, ramp, 1, 1

*VFUN, natural_frequencies(1,1), COMP, MODES_INDEXES(1,1)

