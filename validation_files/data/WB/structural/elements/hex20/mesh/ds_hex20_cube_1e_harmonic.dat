       20     1.000000000E+00     5.000000000E-01     1.000000000E+00
-1
/wb,elem,start            !  set before creation of elements
/com,*********** Elements for Body 1 "cube_1m3-FreeParts|Ressalto-extrus_o1" ***********
et,1,186
keyo,1,2,1          ! set full integration on SOLID186
eblock,19,solid,,1
(19i9)
        1        1        1        1        0        0        0        0       20        0        1        1        5        6        2        3        7        8        4
       11       17       13        9       15       20       16       14       10       18       19       12
-1
!Material Id = {ECDE8050-C206-4F1A-80E5-A1BC79C8447B}
/wb,elem,end               !  done creating elements
/com,*********** Send User Defined Coordinate System(s) ***********
csys,0
toffst,273.15,  ! Temperature offset from absolute zero
/com,*********** Set Reference Temperature ***********
tref,22.
/wb,mat,start              !  starting to send materials
/com,*********** Send Materials ***********
Temperature = 'TEMP' ! Temperature
MP,DENS,1,7850,	! kg m^-3
MP,C,1,434,	! J kg^-1 C^-1
MP,KXX,1,60.5,	! W m^-1 C^-1
MP,RSVX,1,1.7e-07,	! kg m^3 A^-2 s^-3
MP,EX,1,200000000000,	! Pa
MP,NUXY,1,0.3,
MP,MURX,1,10000,
MP,UVID,1,6c7bf0c7-236f-4d36-9368-7cf9734f5fc8
MP,UMID,1,59002a79-71c2-428e-906b-55d7dbee100e

/wb,mat,end                !  done sending materials
!************************* Model Summary ********************
!cube_1m3-FreeParts|Ressalto-extrus_o1,	Structural Steel,	matid,	1
!************************* End Model Summary ********************
! get the diagonal of the bounding box. Needed later for other things
*get,_xmin,node,,mnloc,x
*get,_ymin,node,,mnloc,y
*get,_zmin,node,,mnloc,z
*get,_xmax,node,,mxloc,x
*get,_ymax,node,,mxloc,y
*get,_zmax,node,,mxloc,z
_ASMDIAG=(_xmax-_xmin)*(_xmax-_xmin)+(_ymax-_ymin)*(_ymax-_ymin)+(_zmax-_zmin)*(_zmax-_zmin)
_ASMDIAG=SQRT(_ASMDIAG)
/wb,contact,start          !  starting to send contact
/wb,contact,end            !  done creating contacts
/com,*********** Send Named Selection as Node Component ***********
CMBLOCK,INPUT_FACE,NODE,        8
(8i10)
         1         2         5         6         9        11        13        17

/com,*********** Send Named Selection as Node Component ***********
CMBLOCK,OUTPUT_FACE,NODE,        8
(8i10)
         3         4         7         8        14        15        16        20

cmsel,s,INPUT_FACE
D,ALL,ALL,
nsel,all
esel,all

cmsel,s,OUTPUT_FACE
F,ALL,FY,1,
F,ALL,FZ,1,
nsel,all
esel,all

N_FREQ = 20

/solu
antype,harm
hropt,full
thexpand,off     ! ignore thermal strains
kbc,1
harfrq,0,2000
nsub,N_FREQ
outres,erase
outres,all,none
outres,nsol,all
outres,eangl,all
outres,etmp,all
outres,veng,all
outres,strs,all
outres,epel,all
outres,rsol,all
outres,cont,all

EMATWRITE, YES
WRFULL,YES

SOLVE

FINISH  

/POST1

N_COL = 1 + 6*N_FREQ

!
*dim,ratio,ARRAY,N_FREQ,1
*DIM,frequencies,ARRAY,N_FREQ,1
!
ESEL, ALL
NSEL, ALL
!
!CMSEL,S,'input_face',NODE
CM,LIST_NODES,NODE
!
*GET,N_NODES,NODE,,COUNT
*GET,N_MAX,NODE,,num,max
!
*DIM,DISPLACEMENS,ARRAY,N_NODES,N_COL
*DIM,mask_U,array,N_MAX
*DIM,NODES_NS_U,ARRAY,N_NODES,1
*DIM,NODES_ID_FULL_U,ARRAY,N_MAX,1
*DIM,data_full_U,array,N_MAX,N_COL
!
*VGET,NODES_NS_U,NODE,,NLIST
*VGET,mask_U(1),NODE,,NSEL
*VFILL,NODES_ID_FULL_U,ramp,1,1

!Harmonic Analysis create a 2*Nf set of results (Real part + Imaginary part)

*DO,I,1,N_FREQ,1

! STORE REAL PART OF DISPLACEMENT

SET,1,I,,0

*GET, frequencies(I,1), ACTIVE, 0, SET, FREQ,

*VMASK,mask_U(1)
*VGET,data_full_U(1,2+(I-1)*6),NODE,all,U,X

*VMASK,mask_U(1)
*VGET,data_full_U(1,4+(I-1)*6),NODE,all,U,Y

*VMASK,mask_U(1)
*VGET,data_full_U(1,6+(I-1)*6),NODE,all,U,Z

! STORE IMAGINARY PART OF DISPLACEMENT

SET,1,I,,1

*VMASK,mask_U(1)
*VGET,data_full_U(1,3+(I-1)*6),NODE,all,U,X

*VMASK,mask_U(1)
*VGET,data_full_U(1,5+(I-1)*6),NODE,all,U,Y

*VMASK,mask_U(1)
*VGET,data_full_U(1,7+(I-1)*6),NODE,all,U,Z


*VMASK,mask_U(1)
*VFUN,DISPLACEMENS(1,2+(I-1)*6),COMP,data_full_U(1,2+(I-1)*6)

*VMASK,mask_U(1)
*VFUN,DISPLACEMENS(1,4+(I-1)*6),COMP,data_full_U(1,4+(I-1)*6)

*VMASK,mask_U(1)
*VFUN,DISPLACEMENS(1,6+(I-1)*6),COMP,data_full_U(1,6+(I-1)*6)


*VMASK,mask_U(1)
*VFUN,DISPLACEMENS(1,3+(I-1)*6),COMP,data_full_U(1,3+(I-1)*6)

*VMASK,mask_U(1)
*VFUN,DISPLACEMENS(1,5+(I-1)*6),COMP,data_full_U(1,5+(I-1)*6)

*VMASK,mask_U(1)
*VFUN,DISPLACEMENS(1,7+(I-1)*6),COMP,data_full_U(1,7+(I-1)*6)

*ENDDO

*VMASK,mask_U(1)
*VFUN,DISPLACEMENS(1,1),COMP,NODES_ID_FULL_U(1,1)


!!! Exporta os resultados nodais - pressões Re{P} e Im{P}

*MWRITE,DISPLACEMENS,nodal_displacements_reference,dat
(F10.0,TL1,10000E20.12)


!
ESEL, ALL
NSEL, ALL

!CMSEL,S,'input_face',NODE
CM,LIST_NODES,NODE
!
*GET,N_NODES,NODE,,COUNT
*GET,N_MAX,NODE,,num,max
!
*DIM,STRESSES,ARRAY,N_NODES,N_COL
*DIM,mask_S,array,N_MAX
*DIM,NODES_NS_S,ARRAY,N_NODES,1
*DIM,NODES_ID_FULL_S,ARRAY,N_MAX,1
*DIM,data_full_S,array,N_MAX,N_COL
!
*VGET,NODES_NS_S,NODE,,NLIST
*VGET,mask_S(1),NODE,,NSEL
*VFILL,NODES_ID_FULL_S,ramp,1,1

!Harmonic Analysis create a 2*Nf set of results (Real part + Imaginary part)

*DO,I,1,N_FREQ,1

! STORE REAL PART OF DISPLACEMENT

SET,1,I,,0

*GET, frequencies(I,1), ACTIVE, 0, SET, FREQ,

*VMASK,mask_S(1)
*VGET,data_full_S(1,2+(I-1)*6),NODE,all,S,X

*VMASK,mask_S(1)
*VGET,data_full_S(1,4+(I-1)*6),NODE,all,S,Y

*VMASK,mask_S(1)
*VGET,data_full_S(1,6+(I-1)*6),NODE,all,S,Z

! STORE IMAGINARY PART OF DISPLACEMENT

SET,1,I,,1

*VMASK,mask_S(1)
*VGET,data_full_S(1,3+(I-1)*6),NODE,all,S,X

*VMASK,mask_S(1)
*VGET,data_full_S(1,5+(I-1)*6),NODE,all,S,Y

*VMASK,mask_S(1)
*VGET,data_full_S(1,7+(I-1)*6),NODE,all,S,Z


*VMASK,mask_S(1)
*VFUN,STRESSES(1,2+(I-1)*6),COMP,data_full_S(1,2+(I-1)*6)

*VMASK,mask_S(1)
*VFUN,STRESSES(1,4+(I-1)*6),COMP,data_full_S(1,4+(I-1)*6)

*VMASK,mask_S(1)
*VFUN,STRESSES(1,6+(I-1)*6),COMP,data_full_S(1,6+(I-1)*6)


*VMASK,mask_S(1)
*VFUN,STRESSES(1,3+(I-1)*6),COMP,data_full_S(1,3+(I-1)*6)

*VMASK,mask_S(1)
*VFUN,STRESSES(1,5+(I-1)*6),COMP,data_full_S(1,5+(I-1)*6)

*VMASK,mask_S(1)
*VFUN,STRESSES(1,7+(I-1)*6),COMP,data_full_S(1,7+(I-1)*6)

*ENDDO

*VMASK,mask_S(1)
*VFUN,STRESSES(1,1),COMP,NODES_ID_FULL_S(1,1)


!!! Exporta os resultados nodais - pressões Re{P} e Im{P}

*MWRITE,STRESSES,nodal_stresses_reference,dat
(F10.0,TL1,10000E20.12)


!!! Vetor frequencias da Analise Harmonica

*CFOPEN, analysis_frequencies, dat
*VWRITE,frequencies(1,1)
(F10.4)
*CFCLOS

FINISH
