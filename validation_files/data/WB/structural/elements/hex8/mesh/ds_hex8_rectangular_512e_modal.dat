!Material Id = {DCC85B21-D6B7-43B4-A673-F3557B680BAB}
/wb,elem,end               !  done creating elements
/com,*********** Send User Defined Coordinate System(s) ***********
csys,0
toffst,273.15,  ! Temperature offset from absolute zero
/com,*********** Set Reference Temperature ***********
tref,22.
/wb,mat,start              !  starting to send materials
/com,*********** Send Materials ***********
Temperature = 'TEMP' ! Temperature
MP,DENS,1,7850,	! kg m^-3
MP,C,1,434,	! J kg^-1 C^-1
MP,KXX,1,60.5,	! W m^-1 C^-1
MP,RSVX,1,1.7e-07,	! kg m^3 A^-2 s^-3
MP,EX,1,200000000000,	! Pa
MP,NUXY,1,0.3,
MP,MURX,1,10000,
MP,UVID,1,6c7bf0c7-236f-4d36-9368-7cf9734f5fc8
MP,UMID,1,59002a79-71c2-428e-906b-55d7dbee100e

/wb,mat,end                !  done sending materials
!************************* Model Summary ********************
!rectangular_cavity-FreeParts|Ressalto-extrus_o1,	Structural Steel,	matid,	1
!************************* End Model Summary ********************
! get the diagonal of the bounding box. Needed later for other things
*get,_xmin,node,,mnloc,x
*get,_ymin,node,,mnloc,y
*get,_zmin,node,,mnloc,z
*get,_xmax,node,,mxloc,x
*get,_ymax,node,,mxloc,y
*get,_zmax,node,,mxloc,z
_ASMDIAG=(_xmax-_xmin)*(_xmax-_xmin)+(_ymax-_ymin)*(_ymax-_ymin)+(_zmax-_zmin)*(_zmax-_zmin)
_ASMDIAG=SQRT(_ASMDIAG)
/wb,contact,start          !  starting to send contact
/wb,contact,end            !  done creating contacts
/com,*********** Send Named Selection as Node Component ***********
CMBLOCK,INPUT_FACE,NODE,       45
(8i10)
       361       362       398       399       400       446       447       483
       484       485       593       594       595       597       598       603
       604       738       739       740       741       742       743       744
       745       746       747       748       749       750       751       752
       753       754       755       756       757       758       759       760
       761       762       763       764       765
/com,*********** Send Named Selection as Node Component ***********
CMBLOCK,OUTPUT_FACE,NODE,       45
(8i10)
       363       364       395       396       397       448       449       480
       481       482       591       592       596       599       600       601
       602       605       606       607       608       609       610       611
       612       613       614       615       616       617       618       619
       620       621       622       623       624       625       626       627
       628       629       630       631       632


/solu
antype,2                   ! modal analysis
_thickRatio=  1     ! Ratio of thick parts in the model
modopt,lanb,6
outres,erase
outres,all,none
outres,nsol,all
outres,eangl,all
outres,etmp,all
outres,veng,all
outres,strs,all
outres,epel,all
outres,rsol,all
outres,cont,all
mxpand                    ! default expand in case of complex solution

EMATWRITE, YES
WRFULL,YES

SOLVE
/com *************** Write FE CONNECTORS ********* 
CEWRITE,file,ce,,INTE
*get,_nmodalsolproc,active,0,numcpu

FINISH

!/POST1
/AUX2

! commands to create dense matrix

*DO, n_el, 1, 512, 1

*DMAT, MatK, D, IMPORT, EMAT, file.emat, STIFF, n_el
*EXPORT, MatK, MMF, Ke_%n_el%_ansys.txt,

*DMAT, MatM, D, IMPORT, EMAT, file.emat, MASS, n_el
*EXPORT, MatM, MMF, Me_%n_el%_ansys.txt,

*ENDDO

! Stiffness global matrix
!*DMAT,K_dense,D,IMPORT,FULL,file.full,STIFF
!*EXPORT,K_dense,CSV,Ke_ansys.csv,24,
!*PRINT,K_dense,Kdense_full.dat

! Mass global matrix
!*DMAT,M_dense,D,IMPORT,FULL,file.full,MASS
!*EXPORT,M_dense,CSV,Me_ansys.csv,24,
!*PRINT,M_dense,Mdense_full.dat

FINISH
