*DO, n_el, 1, 64, 1

*DMAT, MatK, D, IMPORT, EMAT, file.emat, STIFF, n_el
*EXPORT, MatK, MMF, Ke_%n_el%_ansys.txt,

*DMAT, MatM, D, IMPORT, EMAT, file.emat, MASS, n_el
*EXPORT, MatM, MMF, Me_%n_el%_ansys.txt,

*ENDDO

! Stiffness global matrix
!*DMAT,K_dense,D,IMPORT,FULL,file.full,STIFF
!*EXPORT,K_dense,CSV,Ke_ansys.csv,24,
!*PRINT,K_dense,Kdense_full.dat

! Mass global matrix
!*DMAT,M_dense,D,IMPORT,FULL,file.full,MASS
!*EXPORT,M_dense,CSV,Me_ansys.csv,24,
!*PRINT,M_dense,Mdense_full.dat

FINISH
