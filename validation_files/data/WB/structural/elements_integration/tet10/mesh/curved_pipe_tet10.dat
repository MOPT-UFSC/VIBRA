esel,s,type,,2
keyop,2,7,1                ! Use original area for application of load
esel,all

*DIM,_loadvari53,TABLE,1,1,1,TIME
! Time values
*TAXIS,_loadvari53(1),1,1.
! Load values
_loadvari53(1,1,1) = 1000.



*DIM,_loadvari53i,TABLE,1,1,1,TIME
! Time values
*TAXIS,_loadvari53i(1),1,1.
! Load values
_loadvari53i(1,1,1) = 0.


